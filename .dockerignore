# Deny by default. Only the Phase 9 worker build inputs below enter Docker.
**

!package.json
!package-lock.json

!workers/
!workers/phase9-runtime/
!workers/phase9-runtime/**
!workers/phase9-media-validation-worker/
!workers/phase9-media-validation-worker/**
!workers/phase9-vision-analysis-worker/
!workers/phase9-vision-analysis-worker/**
!workers/phase9-metadata-worker/
!workers/phase9-metadata-worker/**

!supabase/
!supabase/functions/
!supabase/functions/_shared/
!supabase/functions/_shared/imageInventory/
!supabase/functions/_shared/imageInventory/**

# Explicit private/local exclusions remain visible as merge-blocking policy.
.env*
.git
.git/**
node_modules
node_modules/**
.phase9-dist
.phase9-dist/**
dist
dist/**
coverage
coverage/**
.expo
.expo/**
.codex
.codex/**
.agents
.agents/**
*.log
*.pem
*.key
*secret*
