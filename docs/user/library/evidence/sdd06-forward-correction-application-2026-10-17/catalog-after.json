  "functions": [
    {
      "body": "\n  SELECT pg_catalog.cardinality(pg_catalog.regexp_split_to_array(\n    pg_catalog.btrim(COALESCE(p_content,''),\n      U&'\\0009\\000A\\000B\\000C\\000D\\0020\\00A0\\1680\\2000\\2001\\2002\\2003\\2004\\2005\\2006\\2007\\2008\\2009\\200A\\2028\\2029\\202F\\205F\\3000\\FEFF'),\n    U&'[\\0009\\000A\\000B\\000C\\000D\\0020\\00A0\\1680\\2000\\2001\\2002\\2003\\2004\\2005\\2006\\2007\\2008\\2009\\200A\\2028\\2029\\202F\\205F\\3000\\FEFF]+')) <= 500\n",
      "name": "check_note_word_limit",
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "definer": false,
      "returns": "boolean",
      "arguments": 1,
      "volatility": "i"
    },
    {
      "body": "\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    NEW.version := 1;\n    NEW.last_operation_id := NULL;\n    NEW.created_at := pg_catalog.statement_timestamp();\n  ELSE\n    IF NEW.id IS DISTINCT FROM OLD.id OR NEW.user_id IS DISTINCT FROM OLD.user_id\n      OR NEW.user_book_id IS DISTINCT FROM OLD.user_book_id THEN\n      RAISE EXCEPTION 'LIBRARY_NOTE_IDENTITY_IMMUTABLE' USING ERRCODE='23514';\n    END IF;\n    NEW.version := OLD.version + 1;\n    NEW.created_at := OLD.created_at;\n    IF NEW.last_operation_id IS NOT DISTINCT FROM OLD.last_operation_id THEN\n      NEW.last_operation_id := NULL;\n    END IF;\n  END IF;\n  NEW.updated_at := pg_catalog.statement_timestamp();\n  RETURN NEW;\nEND\n",
      "name": "library_manage_note_revision",
      "owner": "postgres",
      "config": [
        "search_path=\"\""
      ],
      "definer": false,
      "returns": "trigger",
      "arguments": 0,
      "volatility": "v"
    }
  ],
