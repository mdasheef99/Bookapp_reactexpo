    ],
    "triggers": null,
    "functions": [
      {
        "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
        "config": [
          "search_path=public"
        ],
        "signature": "check_note_word_limit(text)",
        "definition": "CREATE OR REPLACE FUNCTION public.check_note_word_limit(p_content text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public'\nAS $function$\n  SELECT COALESCE(array_length(regexp_split_to_array(btrim(COALESCE(p_content,'')), '\\s+'), 1), 0) <= 500\n$function$\n",
        "security_definer": false
      }
    ],
    "privileges": [
