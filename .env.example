# Environment Variables for BookTalks Mobile
# Copy this file to .env.local and fill in your values

# Development Auth Bypass
# Set to 'true' only to bypass authentication entirely during local UI-only development
# Keep this `false` when testing real Clubs/auth flows and Supabase session persistence
# WARNING: Never set this to 'true' in production builds
EXPO_PUBLIC_DEV_SKIP_AUTH=false

# Dev phone OTP testing
# The current real-session dev phone login is configured in Supabase Auth project settings,
# not through additional EXPO_PUBLIC_DEV_PHONE_* environment variables.
# The app uses the normal +91-prefixed phone OTP flow and normal persisted Supabase sessions.

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Sentry Configuration
# DSN is safe for client runtime config, but keep build auth tokens in CI/EAS secrets only
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_SENTRY_IN_DEV=false
EXPO_PUBLIC_SENTRY_TEST_EVENT=false

# Optional release/build metadata
# Set this only if you want a custom build identifier attached to Sentry events
EXPO_PUBLIC_APP_BUILD=

# Build-time only Sentry values (configure in CI/EAS secrets, not in app runtime env)
# SENTRY_AUTH_TOKEN=your-build-token
# SENTRY_ORG=quasarsq
# SENTRY_PROJECT=javascript-react
